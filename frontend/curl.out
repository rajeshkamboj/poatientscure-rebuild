ocus:ring-offset-2 focus:ring-offset-background dark:bg-surface-dark dark:border-surface-dark/50 dark:text-text dark:placeholder-text-text/40" name="q"/><button type="submit" class="absolute inset-y-0 right-0 flex items-center px-3 text-primary/80 hover:text-primary"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"></circle><path d="m21 21-4.35-4.35"></path></svg></button></form></div><div class="flex items-center md:hidden"><button class="p-2 rounded-md text-text/60 hover:text-primary hover:bg-primary/10"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"></path></svg></button></div></div><div class="md:hidden hidden"><div class="px-2 pt-2 pb-3 space-y-1 sm:px-3"><a class="block px-3 py-2 rounded-md text-base font-medium text-text/70 hover:text-primary hover:bg-primary/10" href="/">Home</a><a class="block px-3 py-2 rounded-md text-base font-medium text-text/70 hover:text-primary hover:bg-primary/10" href="/diseases">Diseases</a><a class="block px-3 py-2 rounded-md text-base font-medium text-text/70 hover:text-primary hover:bg-primary/10" href="/remedies">Remedies</a><a class="block px-3 py-2 rounded-md text-base font-medium text-text/70 hover:text-primary hover:bg-primary/10" href="/ingredients">Ingredients</a></div></div></div></header><main class="flex-1"><div class="min-h-screen bg-background dark:bg-background-dark"><main class="flex-1"><section class="relative bg-gradient-to-b from-primary/90 to-background pt-24 pb-20"><div class="container"><div class="text-center"><h1 class="text-5xl font-bold text-white mb-6">Discover Authentic Ayurvedic Wisdom</h1><p class="text-xl text-text/80 max-w-2xl mx-auto mb-8">Explore time-tested remedies, natural ingredients, and holistic approaches to health and wellness.</p><div class="flex justify-center gap-4"><a class="btn-primary hover:bg-primary/90" href="/diseases">Browse Diseases</a><a class="btn-outline border-white hover:bg-primary/20" href="/remedies">Explore Remedies</a></div></div></div><div class="absolute inset-0 pointer-events-none"><div class="absolute top-0 left-0 w-full h-16 bg-gradient-to-t from-primary/10 to-transparent"></div><div class="absolute bottom-0 left-0 w-full h-16 bg-gradient-to-b from-primary/10 to-transparent"></div></div></section><section class="px-4 py-16 sm:px-6 lg:px-8 bg-background/50 dark:bg-surface-dark/50"><div class="container"><h2 class="sr-only">Featured health topics</h2><div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4"><a class="group" href="/diseases/diabetes-type2"><div class="card hover:-translate-y-1 hover:shadow-xl transition-all duration-300 cursor-pointer"><div class="p-6"><div class="flex items-center space-x-3 mb-4"><div class="w-8 h-8 bg-primary/10 rounded-xl flex items-center justify-center"><svg class="h-5 w-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22c1.1 0 2-.9 2-2h-4a2 2 0 0 0-2 2z"></path><path d="M12 7V4a5 5 0 0 1 5-5h2a2 2 0 0 1 2 2v1.5a7 7 0 0 0-11 0V6a2 2 0 0 1 2-2h2a5 5 0 0 1 5 5z"></path></svg></div><h3 class="text-lg font-semibold text-text/90 dark:text-text">Type 2 Diabetes</h3></div><p class="mt-2 text-sm text-text/70 dark:text-text/60 line-clamp-3">Type 2 diabetes is a chronic condition that affects the way the body processes blood sugar (glucose).</p><div class="mt-4 flex items-center text-xs text-text/50 dark:text-text/40"><span>Last updated: <!-- -->September 10, 2026</span></div></div></div></a><a class="group" href="/remedies/turmeric-milk"><div class="card hover:-translate-y-1 hover:shadow-xl transition-all duration-300 cursor-pointer"><div class="p-6"><div class="flex items-center space-x-3 mb-4"><div class="w-8 h-8 bg-secondary/10 rounded-xl flex items-center justify-center"><svg class="h-5 w-5 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s-4-1.5-4-4V8c0-6 5-8 8-8s8 2 8 8v2c0 2.5-2.5 4.5-4 5v7"></path><path d="M16 16v1.5a2.5 2.5 0 0 1-2.5 2.5H9"></path></svg></div><h3 class="text-lg font-semibold text-text/90 dark:text-text">Turmeric Milk (Golden Milk)</h3></div><p class="mt-2 text-sm text-text/70 dark:text-text/60 line-clamp-3">Anti-inflammatory, boosts immunity, promotes better sleep</p><div class="mt-4 flex flex-wrap gap-2"><span class="bg-secondary/20 text-secondary px-2.5 py-1 rounded text-xs font-medium">Milk (dairy or plant-based)</span><span class="bg-secondary/20 text-secondary px-2.5 py-1 rounded text-xs font-medium">Turmeric powder</span><span class="bg-secondary/20 text-secondary px-2.5 py-1 rounded text-xs font-medium">Black pepper</span><span class="bg-secondary/20 text-secondary px-2.5 py-1 rounded text-xs font-medium">Honey or jaggery (optional)</span><span class="bg-secondary/20 text-secondary px-2.5 py-1 rounded text-xs font-medium">Cardamom (optional)</span></div></div></div></a><a class="group" href="/ingredients/turmeric"><div class="card hover:-translate-y-1 hover:shadow-xl transition-all duration-300 cursor-pointer"><div class="p-6"><div class="flex items-center space-x-3 mb-4"><div class="w-8 h-8 bg-accent/10 rounded-xl flex items-center justify-center"><svg class="h-5 w-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s-4-1.5-4-4V8c0-6 5-8 8-8s8 2 8 8v2c0 2.5-2.5 4.5-4 5v7"></path><path d="M16 11.2a4 4 0 1 1-5.6 5.6"></path><path d="M12 16.5a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z"></path></svg></div><h3 class="text-lg font-semibold text-text/90 dark:text-text">Turmeric</h3></div><p class="mt-2 text-sm text-text/70 dark:text-text/60 line-clamp-3">Turmeric is a bright yellow spice derived from the root of the Curcuma longa plant. It has been used for centuries in Ayurvedic medicine for its anti-inflammatory and antioxidant properties.</p><div class="mt-4 flex flex-wrap gap-2"><span class="bg-accent/20 text-accent px-2.5 py-1 rounded text-xs font-medium">Anti-inflammatory</span><span class="bg-accent/20 text-accent px-2.5 py-1 rounded text-xs font-medium">Antioxidant</span></div></div></div></a><a class="group" href="/ingredients/fenugreek"><div class="card hover:-translate-y-1 hover:shadow-xl transition-all duration-300 cursor-pointer"><div class="p-6"><div class="flex items-center space-x-3 mb-4"><div class="w-8 h-8 bg-accent/10 rounded-xl flex items-center justify-center"><svg class="h-5 w-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s-4-1.5-4-4V8c0-6 5-8 8-8s8 2 8 8v2c0 2.5-2.5 4.5-4 5v7"></path><path d="M16 11.2a4 4 0 1 1-5.6 5.6"></path><path d="M12 16.5a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z"></path></svg></div><h3 class="text-lg font-semibold text-text/90 dark:text-text">Fenugreek</h3></div><p class="mt-2 text-sm text-text/70 dark:text-text/60 line-clamp-3">Fenugreek is an annual plant in the family Fabaceae, with leaves consisting of three small obovate to oblong leaflets. It is cultivated worldwide as a semiarid crop, and its seeds are a common ingredient in dishes from the Indian subcontinent.</p><div class="mt-4 flex flex-wrap gap-2"><span class="bg-accent/20 text-accent px-2.5 py-1 rounded text-xs font-medium">Helps regulate blood sugar</span><span class="bg-accent/20 text-accent px-2.5 py-1 rounded text-xs font-medium">Increases breast milk production</span></div></div></div></a></div></div></section><section class="px-4 py-16 sm:px-6 lg:px-8"><div class="container"><h2 class="text-3xl font-bold text-text/90 dark:text-text mb-8">Latest Health Articles</h2><div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3"><a class="group" href="/diseases/diabetes-type2"><div class="h-full card hover:-translate-y-1 hover:shadow-xl transition-all duration-300 cursor-pointer"><div class="p-6"><h3 class="text-lg font-semibold text-text/90 dark:text-text mb-3">Type 2 Diabetes</h3><p class="text-sm text-text/70 dark:text-text/60 line-clamp-3">Type 2 diabetes is a chronic condition that affects the way the body processes blood sugar (glucose).</p><div class="mt-4 flex items-center text-xs text-text/50 dark:text-text/40"><span>Last updated: <!-- -->September 10, 2026</span></div></div></div></a></div></div></section><section class="px-4 py-16 sm:px-6 lg:px-8 bg-background/50 dark:bg-surface-dark/50"><div class="container"><h2 class="text-3xl font-bold text-text/90 dark:text-text mb-8">Trusted Ayurvedic Knowledge</h2><div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3"><div class="card hover:-translate-y-1 hover:shadow-xl transition-all duration-300 cursor-pointer"><div class="p-6"><h3 class="text-lg font-semibold text-text/90 dark:text-text mb-4">Evidence-Based Approach</h3><p class="text-text/70 dark:text-text/60">Our content combines traditional Ayurvedic wisdom with modern scientific research to provide accurate, reliable health information.</p></div></div><div class="card hover:-translate-y-1 hover:shadow-xl transition-all duration-300 cursor-pointer"><div class="p-6"><h3 class="text-lg font-semibold text-text/90 dark:text-text mb-4">Expert Reviewed</h3><p class="text-text/70 dark:text-text/60">All articles are reviewed by qualified Ayurvedic practitioners and medical professionals to ensure accuracy and safety.</p></div></div><div class="card hover:-translate-y-1 hover:shadow-xl transition-all duration-300 cursor-pointer"><div class="p-6"><h3 class="text-lg font-semibold text-text/90 dark:text-text mb-4">Traditional Wisdom</h3><p class="text-text/70 dark:text-text/60">We preserve and share authentic Ayurvedic knowledge passed down through generations, adapted for modern lifestyles.</p></div></div></div></div></section></main></div><!--$--><!--/$--></main><footer class="bg-primary"><div class="container"><div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4 py-12"><div><h3 class="mb-4 text-2xl font-bold text-white">PatientScure</h3><p class="text-white">Providi